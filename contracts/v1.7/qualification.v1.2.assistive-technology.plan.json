    {
      "laneId": "alternative-input",
      "evidenceType": "assistive-technology",
      "maySatisfyGroupAfterGovernedReview": true,
      "additionalRequiredGroupsRemain": ["human"]
    }
  ],
  "currentBoundary": {
    "protocolEstablished": true,
    "manualAssistiveTechnologyEvidenceEstablished": false,
    "assistiveTechnologyLaneClosed": false,
    "alternativeInputLaneClosed": false,
    "humanAccessibilityAcceptanceEstablished": false,
    "deviceEvidenceEstablished": false,
    "section41Complete": false,
    "section48Accepted": false,
    "v171AcceptanceEstablished": false,
    "lifecyclePromotionEstablished": false,
    "consumerAcceptanceEstablished": false,
    "deploymentAcceptanceEstablished": false,
    "productionAcceptanceEstablished": false
  },
  "record": {
    "sourceRevisionRequired": "4b9d085a5177b96cc31d4270b38d792a59872e37",
    "sourceRevisionFormat": "40-lowercase-hex",
    "toolingRevisionFormat": "40-lowercase-hex",
    "repository": "GoreeCloud/glaze",
    "manualExecutionRequired": true,
    "physicalDeviceRequiredForSession": true,
    "placeholderValuesProhibited": true,
    "requiredTopLevelFields": [
      "schemaVersion",
      "recordType",
      "sourceRevision",
      "toolingRevision",
      "repository",
      "capturedAt",
      "operator",
      "manualExecution",
      "platform",
      "device",
      "assistiveTechnology",
      "scenarios",
      "sessionDecision",
      "sessionSummary",
      "authority"
