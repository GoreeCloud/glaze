    "recognizedTechnologies": [
      "TalkBack",
      "Voice Access",
      "Switch Access",
      "VoiceOver",
      "Switch Control",
      "Orca",
      "Narrator",
      "Other"
    ],
    "requiredScenarioIds": [
      "source-and-orientation",
      "navigate-semantic-regions",
      "activate-semantic-actions",
      "focus-order-and-reachability",
      "names-roles-states-and-values",
      "dynamic-status-and-recovery-announcement",
      "large-text-200-percent",
      "reduced-transparency-and-forced-colors",
      "switch-voice-alternative-paths",
      "task-continuity-across-input-change"
