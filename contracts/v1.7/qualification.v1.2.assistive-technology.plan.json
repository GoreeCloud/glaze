  "requiredObservationDimensions": [
    "spoken-or-presented-name",
    "role-state-and-value",
    "reading-and-focus-order",
    "action-reachability",
    "dynamic-state-announcement",
    "error-and-recovery-feedback",
    "large-text-reflow-and-reachability",
    "accessibility-preference-precedence",
    "alternative-input-path",
    "task-and-focus-continuity"
  ],
  "implementation": {
    "validator": "scripts/validate_glaze_v1_7_1_assistive_technology_qualification.py",
    "workflow": ".github/workflows/glaze-v1.7.1-assistive-technology-qualification-control.yml",
    "humanProcedure": "acceptance/v1.7.1-assistive-technology-qualification.md",
    "recordTemplate": "acceptance/v1.7.1-assistive-technology-evidence.template.json",
    "reviewHarness": "reference/v1.7/assistive-technology-qualification.html",
    "preparationHelper": "scripts/prepare_glaze_v1_7_1_assistive_technology_qualification.py"
  },
  "boundary": "This contract establishes a fail-closed manual assistive-technology qualification control only. Synthetic self-tests, CI, accessibility-tree inspection, keyboard automation, and the fail-closed template are not assistive-technology evidence. Real exact-source manual sessions on physical devices must be separately reviewed and governed before they may satisfy an assistive-technology evidence group; no lane, Section 41/48 acceptance, V1.7.1 lifecycle, consumer, deployment, or production authority is granted automatically."
}
