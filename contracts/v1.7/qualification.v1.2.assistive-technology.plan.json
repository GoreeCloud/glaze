    "scenarioStatus": [
      "pass",
      "fail",
      "not-applicable-with-reason"
    ],
    "sessionDecisionValues": [
      "session-pass",
      "session-fail"
    ]
  },
  "acceptanceRules": {
    "operatorIdentityRequired": true,
    "technologyVersionRequired": true,
    "manualExecutionRequired": true,
    "machineAccessibilityTreeAloneIsAssistiveTechnologyEvidence": false,
    "browserAccessibilityTreeAloneIsScreenReaderEvidence": false,
    "automatedKeyboardTraversalAloneIsAssistiveTechnologyEvidence": false,
    "hostedCiMayClaimManualAssistiveTechnologyEvidence": false,
    "emulatorSessionMaySupportDevelopmentButNotPhysicalSessionQualification": true,
    "sessionPassImpliesAssistiveTechnologyLaneClosed": false,
    "sessionPassImpliesAlternativeInputLaneClosed": false,
    "singleTechnologyPassImpliesSupportMatrixAcceptance": false,
    "singlePlatformPassImpliesCompleteNativeParity": false,
    "protocolValidationImpliesHumanAcceptance": false,
    "protocolValidationImpliesSection48Acceptance": false,
    "protocolValidationImpliesV171Acceptance": false,
    "protocolValidationImpliesLifecyclePromotion": false,
