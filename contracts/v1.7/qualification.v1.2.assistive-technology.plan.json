    "acceptanceRecord": "acceptance/v1.7-development.md"
  },
  "eligibleEvidenceGroups": [
    {
      "laneId": "assistive-technology",
      "evidenceType": "assistive-technology",
      "maySatisfyGroupAfterGovernedReview": true
