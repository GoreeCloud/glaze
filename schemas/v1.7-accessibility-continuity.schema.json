    "continuityRequirements": {"type":"object","minProperties":10},
    "presentationRequirements": {"type":"object","minProperties":10},
    "authority": {"type":"object","minProperties":16},
    "dependencies": {"type":"object","minProperties":7},
    "acceptanceBoundary": {"type":"object","minProperties":19},
    "runtimeEntrypoint": {"const":"js/glaze-v1.7-accessibility-continuity.dev.mjs"},
    "developmentAggregateEntrypoint": {"const":"js/glaze-v1.7-development.mjs"},
