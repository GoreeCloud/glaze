{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-system-shell-continuity-v1-2.schema.json",
  "title": "Glaze UI V1.7 System Shell Continuity v1.2 Development Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "version",
    "lifecycle",
    "stableBaseline",
    "consumerEligible",
    "planVersion",
    "v12SpecificationSections",
    "historicalFoundation",
    "section35Areas",
    "transitionRelationships",
    "motionPolicy",
    "authority",
    "dependencies",
    "acceptanceBoundary"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractId": {"const": "goreecloud.glaze-ui.v1.7.system-shell-continuity-v1-2"},
    "version": {"const": "1.7.0-dev.27"},
    "lifecycle": {"const": "Development"},
    "stableBaseline": {"const": "1.6.0"},
    "consumerEligible": {"const": false},
    "planVersion": {"const": "v1.2"},
    "v12SpecificationSections": {"const": [35]},
    "historicalFoundation": {"type": "object"},
    "section35Areas": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true},
    "transitionRelationships": {"type": "object", "minProperties": 11},
    "motionPolicy": {"type": "object"},
    "authority": {"type": "object"},
    "dependencies": {"type": "object"},
    "acceptanceBoundary": {"type": "object"},
    "runtimeEntrypoint": {"type": "string"},
    "developmentAggregateEntrypoint": {"type": "string"},
    "tokenMap": {"type": "string"}
  },
  "additionalProperties": true
}
