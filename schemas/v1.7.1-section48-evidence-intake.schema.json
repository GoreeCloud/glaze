        "additionalProperties": false,
        "required": [
          "laneId",
          "type",
          "sourceRevision",
          "reference",
          "finding",
          "observedAt",
          "reviewedAt",
          "reviewer",
          "acceptedByGovernedReview",
          "limitations"
