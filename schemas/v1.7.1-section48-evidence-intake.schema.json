        "properties": {
          "laneId": {
            "enum": [
              "workspace-continuity-v13",
              "compact-surface-v13",
              "agent-activity-authority-v13",
              "privacy-attention-authority-v13",
              "accessibility-presentation-v13",
              "creative-state-separation-v13",
              "compare-neutrality-v13",
              "care-authority-v13",
              "large-text-reflow-v13",
              "forced-colors-v13",
              "keyboard-continuity-v13",
              "switch-access-v13",
              "voice-access-v13",
              "compact-device-behavior-v13",
              "provider-integration-v13",
              "privacy-security-integration-v13",
              "cross-platform-expression-v13",
              "performance-v13",
              "energy-v13",
              "human-visual-v13",
              "artifact-provenance-v13",
              "expression-system-v13",
              "contextual-actions-v13",
              "brief-v13",
              "control-center-v13"
            ]
          },
          "type": {
            "enum": [
              "machine",
              "rendered",
              "device",
              "human",
              "assistive-technology",
              "performance",
              "energy",
              "provenance",
              "provider-integration",
              "privacy-security"
            ]
          },
          "sourceRevision": {
            "const": "4b9d085a5177b96cc31d4270b38d792a59872e37"
          },
          "reference": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "acceptedByGovernedReview": {
            "type": "boolean"
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "reviewDecision": {
      "enum": [
        "not-reviewed",
        "reviewed-evidence-inventory"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetIsV171Acceptance",
        "section48Accepted",
        "readyStatusGrantsAcceptance",
        "lifecyclePromotionAutomatic",
        "anchorStatusGranted",
        "consumerEligibilityGranted",
        "deploymentAcceptanceGranted",
        "publicationAutomatic",
        "productionAcceptanceGranted"
      ],
      "properties": {
        "packetIsV171Acceptance": {
          "const": false
        },
        "section48Accepted": {
          "const": false
        },
        "readyStatusGrantsAcceptance": {
          "const": false
        },
        "lifecyclePromotionAutomatic": {
          "const": false
        },
        "anchorStatusGranted": {
          "const": false
        },
        "consumerEligibilityGranted": {
          "const": false
        },
        "deploymentAcceptanceGranted": {
          "const": false
        },
        "publicationAutomatic": {
          "const": false
        },
        "productionAcceptanceGranted": {
          "const": false
        }
      }
