  "$id": "https://goreecloud.dev/schemas/glaze/v1.7.1-section48-evidence-intake.schema.json",
  "title": "Glaze V1.7.1 Section 48 Governed Evidence Intake Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
