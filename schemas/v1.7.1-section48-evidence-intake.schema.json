    },
    "recordId": {
      "const": "goreecloud.glaze.v1.7.1.section48-evidence-intake"
    },
    "lifecycle": {
      "const": "DevelopmentQualification"
    },
    "sourceRevision": {
      "const": "4b9d085a5177b96cc31d4270b38d792a59872e37"
    },
    "toolingRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "section48QualificationModelVersion": {
      "const": "1.7.0-dev.47"
    },
    "stableBaseline": {
      "const": "1.7.0"
    },
    "historicalSourceStableBaseline": {
      "const": "1.6.0"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedAt",
        "reviewer",
        "reviewerRole",
        "scope",
        "representativeRevisionConfirmed",
        "independentReviewConfirmed",
        "notes"
      ],
      "properties": {
        "reviewedAt": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "reviewerRole": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "representativeRevisionConfirmed": {
          "type": "boolean"
        },
        "independentReviewConfirmed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "section48Applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy-v13": {
          "type": "boolean"
        }
      }
    },
    "section48NotApplicableJustifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy-v13": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 2000,
