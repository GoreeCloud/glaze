{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-ui/v1.7-glaze-motion-lifecycle.schema.json",
  "title": "Glaze UI V1.7 Glaze Motion Lifecycle Development Reconciliation",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "version",
    "lifecycle",
    "stableBaseline",
    "consumerEligible",
    "planVersion",
    "v12SpecificationSections",
    "subject",
    "promotionRequirements",
    "evidenceAssessment",
    "currentEvidence",
    "decision",
    "authority",
    "acceptanceBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "goreecloud.glaze-ui.v1.7.glaze-motion-lifecycle"
    },
    "version": {
      "const": "1.7.0-dev.26"
    },
    "lifecycle": {
      "const": "Development"
    },
    "stableBaseline": {
      "const": "1.6.0"
    },
    "consumerEligible": {
      "const": false
    },
    "planVersion": {
      "const": "v1.2"
    },
    "v12SpecificationSections": {
      "const": [
        34
      ]
    },
    "subject": {
      "type": "object"
    },
    "promotionRequirements": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true
    },
    "evidenceAssessment": {
      "type": "object"
    },
    "currentEvidence": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    },
    "authority": {
      "type": "object"
    },
    "acceptanceBoundary": {
      "type": "object"
    },
    "runtimeEntrypoint": {
      "type": "string"
    },
    "developmentAggregateEntrypoint": {
      "type": "string"
    },
    "tokenMap": {
      "type": "string"
    },
    "reconciliationRecord": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
