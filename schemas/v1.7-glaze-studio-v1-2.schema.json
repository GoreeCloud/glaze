{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze-ui/v1.7-glaze-studio-v1-2.schema.json",
  "title": "Glaze UI V1.7 Glaze Studio v1.2 Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema","schemaVersion","contractId","name","version","lifecycle","stableBaseline","consumerEligible",
    "planVersion","v12SpecificationSections","historicalFoundation","previewDomains","comparisonModes",
    "studioCapabilities","authority","privacy","dependencies","acceptanceBoundary","runtimeEntrypoint",
    "developmentAggregateEntrypoint","tokenMap","researchRecord","sourceAuthorities"
  ],
  "properties": {
    "$schema": {"const":"../../schemas/v1.7-glaze-studio-v1-2.schema.json"},
    "schemaVersion": {"const":1},
    "contractId": {"const":"goreecloud.glaze-ui.v1.7.glaze-studio-v1-2"},
    "name": {"const":"Glaze UI V1.7 Glaze Studio v1.2 Development Contract"},
    "version": {"const":"1.7.0-dev.33"},
    "lifecycle": {"const":"Development"},
    "stableBaseline": {"const":"1.6.0"},
    "consumerEligible": {"const":false},
    "planVersion": {"const":"v1.2"},
    "v12SpecificationSections": {"const":[40]},
    "historicalFoundation": {
      "type":"object","additionalProperties":false,
      "required":["version","planNumbering","historicalSpecificationSection","reinterpretedAsV12Section40"],
      "properties":{
        "version":{"const":"1.7.0-dev.12"},
        "planNumbering":{"const":"v1.1-historical-numbering"},
        "historicalSpecificationSection":{"const":27},
        "reinterpretedAsV12Section40":{"const":false}
      }
    },
    "previewDomains": {"type":"array","minItems":11,"maxItems":11,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "comparisonModes": {"const":["calm","balanced","expressive","reduced-motion"]},
    "studioCapabilities": {"type":"object","minProperties":20},
    "authority": {"type":"object","minProperties":16},
    "privacy": {"type":"object","minProperties":6},
    "dependencies": {"type":"object","minProperties":7},
    "acceptanceBoundary": {"type":"object","minProperties":13},
    "runtimeEntrypoint": {"const":"js/glaze-v1.7-studio-v1-2.dev.mjs"},
    "developmentAggregateEntrypoint": {"const":"js/glaze-v1.7-development.mjs"},
    "tokenMap": {"const":"tokens/glaze-v1.7-studio-v1-2.dev.json"},
    "researchRecord": {"const":"research/v1.7-glaze-studio-v1-2.md"},
    "sourceAuthorities": {"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
