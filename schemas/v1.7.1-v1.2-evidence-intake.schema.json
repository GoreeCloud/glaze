{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze/v1.7.1-v1.2-evidence-intake.schema.json",
  "title": "Glaze V1.7.1 Retained V1.2 Governed Evidence Intake Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "recordId",
    "lifecycle",
    "sourceRevision",
    "toolingRevision",
    "acceptanceModelVersion",
    "stableBaseline",
    "historicalSourceStableBaseline",
    "review",
    "retainedApplicability",
    "retainedNotApplicableJustifications",
    "evidence",
    "reviewDecision",
    "authority",
    "boundary"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/v1.7.1-v1.2-evidence-intake.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordId": {
      "const": "goreecloud.glaze.v1.7.1.v1.2-evidence-intake"
    },
    "lifecycle": {
      "const": "DevelopmentQualification"
    },
    "sourceRevision": {
      "const": "4b9d085a5177b96cc31d4270b38d792a59872e37"
    },
    "toolingRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "acceptanceModelVersion": {
      "const": "1.7.0-dev.39"
    },
    "stableBaseline": {
      "const": "1.7.0"
    },
    "historicalSourceStableBaseline": {
      "const": "1.6.0"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedAt",
        "reviewer",
        "reviewerRole",
        "scope",
        "representativeRevisionConfirmed",
        "independentReviewConfirmed",
        "notes"
      ],
      "properties": {
        "reviewedAt": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "reviewerRole": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "representativeRevisionConfirmed": {
          "type": "boolean"
        },
        "independentReviewConfirmed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "retainedApplicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wearable": {
          "type": "boolean"
        },
        "energy-behavior": {
          "type": "boolean"
        }
      }
    },
    "retainedNotApplicableJustifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wearable": {
          "type": "string"
        },
        "energy-behavior": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "laneId",
          "type",
          "sourceRevision",
          "reference",
          "finding",
          "observedAt",
          "reviewedAt",
          "reviewer",
          "acceptedByGovernedReview",
          "limitations"
        ],
        "properties": {
          "laneId": {
            "enum": [
              "task-continuity",
              "adaptive-composition",
              "semantic-color",
              "theme-safety",
              "custom-theme-accessibility",
              "signature-motion",
              "connected-transformations",
              "animation-interruption",
              "animation-reversal",
              "reduced-motion",
              "frame-pacing",
              "input-latency",
              "mobile",
              "tablet",
              "desktop",
              "foldable",
              "tv",
              "wearable",
              "keyboard",
              "pointer",
              "touch",
              "alternative-input",
              "reduced-transparency",
              "increased-contrast",
              "forced-colors",
              "large-text",
              "rtl",
              "representative-rendering",
              "native-behavior",
              "performance",
              "energy-behavior",
              "regression",
              "human-visual-motion-review",
              "assistive-technology",
              "privacy-boundaries",
              "security-boundaries",
              "artifact-provenance"
            ]
          },
          "type": {
            "enum": [
              "machine",
              "rendered",
              "device",
              "human",
              "assistive-technology",
              "performance",
              "energy",
              "provenance"
            ]
          },
          "sourceRevision": {
            "const": "4b9d085a5177b96cc31d4270b38d792a59872e37"
          },
          "reference": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "acceptedByGovernedReview": {
            "type": "boolean"
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "reviewDecision": {
      "enum": [
        "not-reviewed",
        "reviewed-evidence-inventory"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetIsV171Acceptance",
        "section46Complete",
        "readyStatusGrantsAcceptance",
        "lifecyclePromotionAutomatic",
        "anchorStatusGranted",
        "consumerEligibilityGranted",
        "deploymentAcceptanceGranted",
        "publicationAutomatic",
        "productionAcceptanceGranted"
      ],
      "properties": {
        "packetIsV171Acceptance": {
          "const": false
        },
        "section46Complete": {
          "const": false
        },
        "readyStatusGrantsAcceptance": {
          "const": false
        },
        "lifecyclePromotionAutomatic": {
          "const": false
        },
        "anchorStatusGranted": {
          "const": false
        },
        "consumerEligibilityGranted": {
          "const": false
        },
        "deploymentAcceptanceGranted": {
          "const": false
        },
        "publicationAutomatic": {
          "const": false
        },
        "productionAcceptanceGranted": {
          "const": false
        }
      }
    },
    "boundary": {
      "type": "string",
      "minLength": 80
    }
  }
}
