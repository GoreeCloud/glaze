    "v12SpecificationSections": {"const":[44]},
    "governingPrinciple": {"const":"motion-communicates-truth-motion-does-not-create-truth"},
    "truthDomains": {"type":"array","minItems":9,"maxItems":9,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "authorityOwners": {"type":"object","minProperties":9},
    "authorityPolicy": {"type":"object","minProperties":12},
    "motionPolicy": {"type":"object","minProperties":8},
    "dependencies": {"type":"object","minProperties":4},
    "acceptanceBoundary": {"type":"object","minProperties":14},
    "runtimeEntrypoint": {"const":"js/glaze-v1.7-privacy-authority-boundaries.dev.mjs"},
    "developmentAggregateEntrypoint": {"const":"js/glaze-v1.7-development.mjs"},
    "tokenMap": {"const":"tokens/glaze-v1.7-privacy-authority-boundaries.dev.json"},
    "researchRecord": {"const":"research/v1.7-privacy-authority-boundaries.md"}
