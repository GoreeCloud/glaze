{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze-ui/v1.7-privacy-authority-boundaries.schema.json",
  "title": "Glaze UI V1.7 Privacy and Authority Boundaries Development Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
