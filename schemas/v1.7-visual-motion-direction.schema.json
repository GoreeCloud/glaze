{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze-ui/v1.7-visual-motion-direction.schema.json",
  "title": "Glaze UI V1.7 Visual and Motion Direction Development Contract",
  "type": "object",
  "additionalProperties": false,
