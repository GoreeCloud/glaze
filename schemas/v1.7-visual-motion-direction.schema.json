    "planVersion": {"const":"v1.2"},
    "v12SpecificationSections": {"const":[43]},
    "advancementObjectives": {
      "type":"array","minItems":8,"maxItems":8,"uniqueItems":true,
      "items":{"type":"string","minLength":1}
    },
    "governingDirection": {"type":"object","minProperties":8},
    "materialPolicy": {"type":"object","minProperties":8},
    "motionPolicy": {"type":"object","minProperties":8},
    "authority": {"type":"object","minProperties":15},
    "dependencies": {"type":"object","minProperties":7},
    "acceptanceBoundary": {"type":"object","minProperties":14},
    "runtimeEntrypoint": {"const":"js/glaze-v1.7-visual-motion-direction.dev.mjs"},
    "developmentAggregateEntrypoint": {"const":"js/glaze-v1.7-development.mjs"},
    "tokenMap": {"const":"tokens/glaze-v1.7-visual-motion-direction.dev.json"},
    "researchRecord": {"const":"research/v1.7-visual-motion-direction.md"}
  }
}
