    "schemaVersion": {"const":1},
    "contractId": {"const":"goreecloud.glaze-ui.v1.7.visual-motion-direction"},
    "name": {"const":"Glaze UI V1.7 Visual and Motion Direction Development Contract"},
    "version": {"const":"1.7.0-dev.36"},
    "lifecycle": {"const":"Development"},
    "stableBaseline": {"const":"1.6.0"},
