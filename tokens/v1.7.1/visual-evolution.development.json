{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "0.1.0-development",
  "name": "Glaze V1.7.1 Visual Evolution — Exploratory Theme Gallery",
  "lifecycle": "Development",
  "stableBaseline": "1.7.0",
  "consumerEligible": false,
  "paletteAuthority": "demonstration-only; no universal GoreeCloud default hue",
  "assetAuthority": {
    "interfaceIcons": "js/icon-glyph-registry.mjs",
    "vectorSymbols": "assets/icon-glyphs/system-symbols.svg",
    "brandIdentity": "GoreeCloud/branding-assets"
  },
  "layers": [
    "canvas",
    "surface",
    "soft-glaze",
    "glaze",
    "deep-glaze"
  ],
  "semanticPrecedence": [
    "safety-and-authoritative-state",
    "accessibility",
    "interaction",
    "product-identity",
    "decorative-expression"
  ],
  "roles": {
    "structural": [
      "canvas",
      "surface",
      "surfaceRaised",
      "sidebar",
      "border",
      "text",
      "muted",
      "faint",
      "shadow"
    ],
    "interaction": [
      "accent",
      "onAccent",
      "accentSubtle",
      "focus",
      "selected"
    ],
    "protected": [
      "success",
      "warning",
      "danger",
      "information",
      "privacy",
      "security",
      "restricted",
      "offline",
      "syncing"
    ]
  },
